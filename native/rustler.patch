rustler 0.38.0 for wasm32-wasip1, from patches/rustler/0001-wasm32-imports.patch
of BEAM.com (docs/NIFS.md): the enif_* functions are imports of the module
"env". Two more changes: the attribute #[link(wasm_import_module = "env")],
because Rust 1.97 does not give --allow-undefined to the linker of wasm32,
and rustler_codegen from crates.io, not from ../rustler_codegen.
scripts/nif.sh applies it to the crate of a NIF, with Cargo.toml.orig as Cargo.toml.

diff -ruN a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -25,11 +25,11 @@
 
 [dependencies]
 inventory = "0.3"
-rustler_codegen = { path = "../rustler_codegen", version = "0.38.0"}
+rustler_codegen = { version = "0.38.0"}
 num-bigint = { version = "0.4", optional = true }
 serde = { version = "1", optional = true }
 
-[target.'cfg(not(windows))'.dependencies]
+[target.'cfg(not(any(windows, target_family = "wasm")))'.dependencies]
 libloading = "0.9"
 # For RTLD_NOLOAD
 libc = "0.2"
