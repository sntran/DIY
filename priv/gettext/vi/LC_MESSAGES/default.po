msgid "Give the total of the bill in dollars and its kWh, for example 150 and 1,100."
msgstr "Nhập tổng tiền hóa đơn theo đô la và số kWh, ví dụ 150 và 1,100."

#: lib/diy_web/live/home_live.ex:783
#, elixir-autogen, elixir-format
msgid "Remove the rooms of the top floor first."
msgstr "Hãy xóa các phòng ở tầng trên cùng trước."

#: lib/diy_web/live/home_live.ex:959
#, elixir-autogen, elixir-format
msgid "The app cannot keep this plan. A number of the plan is not in the range that the app accepts."
msgstr "Ứng dụng không thể lưu gói điện này. Một con số của gói nằm ngoài khoảng mà ứng dụng chấp nhận."

#: lib/diy_web/live/home_live.ex:883
#, elixir-autogen, elixir-format
msgid "The app cannot read the text of this file."
msgstr "Ứng dụng không đọc được nội dung của tệp này."

#: lib/diy_web/live/home_live.ex:357
#, elixir-autogen, elixir-format
msgid "The app cannot read the usage of this file."
msgstr "Ứng dụng không đọc được mức tiêu thụ trong tệp này."

#: lib/diy_web/live/home_live.ex:877
#, elixir-autogen, elixir-format
msgid "The app cannot read this EFL: it has no average prices."
msgstr "Ứng dụng không đọc được EFL này: nó không có giá trung bình."

#: lib/diy_web/live/home_live.ex:892
#, elixir-autogen, elixir-format
msgid "The app cannot read this file. Open the PDF of an EFL."
msgstr "Ứng dụng không đọc được tệp này. Hãy mở tệp PDF của một EFL."

#: lib/diy_web/live/home_live.ex:742
#, elixir-autogen, elixir-format
msgid "The app now uses the price of your bill: %{price} for each kWh."
msgstr "Ứng dụng hiện dùng giá trong hóa đơn của bạn: %{price} cho mỗi kWh."

#: lib/diy_web/device.ex:76
#, elixir-autogen, elixir-format
msgid "The build is too large for this device. Remove some items."
msgstr "Mô hình quá lớn cho thiết bị này. Hãy xóa bớt một số thiết bị trong nhà."

#: lib/diy_web/device.ex:97
#, elixir-autogen, elixir-format
msgid "The build on this device comes from a newer version of the app. Load the page again."
msgstr "Mô hình trên thiết bị này đến từ phiên bản mới hơn của ứng dụng. Hãy tải lại trang."

#: lib/diy_web/live/home_live.ex:1043
#, elixir-autogen, elixir-format
msgid "The cab and the roof of the van stay where they are."
msgstr "Cabin và mái của xe van giữ nguyên vị trí."

#: lib/diy_web/live/home_live.ex:1126
#, elixir-autogen, elixir-format
msgid "The file is not a build of this app."
msgstr "Tệp này không phải là mô hình của ứng dụng này."

#: lib/diy_web/live/home_live.ex:1170
#, elixir-autogen, elixir-format
msgid "The night must start and end at different hours."
msgstr "Ban đêm phải bắt đầu và kết thúc ở hai giờ khác nhau."

#: lib/diy_web/device.ex:242
#, elixir-autogen, elixir-format
msgid "The page cannot read the build on this device. It starts a new build, and keeps a copy of the old one."
msgstr "Trang không đọc được mô hình trên thiết bị này. Trang bắt đầu một mô hình mới và giữ một bản sao của mô hình cũ."

#: lib/diy_web/live/home_live.ex:380
#, elixir-autogen, elixir-format
msgid "The page has 1 month of your usage from Home Assistant."
msgid_plural "The page has %{count} months of your usage from Home Assistant."
msgstr[0] "Trang có %{count} tháng tiêu thụ của bạn từ Home Assistant."

#: lib/diy_web/live/home_live.ex:348
#, elixir-autogen, elixir-format
msgid "The page has 1 month of your usage. The file stayed on this device."
msgid_plural "The page has %{count} months of your usage. The file stayed on this device."
msgstr[0] "Trang có %{count} tháng tiêu thụ của bạn. Tệp vẫn chỉ ở trên thiết bị này."

#: lib/diy_web/live/home_live.ex:1530
#, elixir-autogen, elixir-format
msgid "The page reads your build from this device."
msgstr "Trang đang đọc mô hình của bạn từ thiết bị này."

#: lib/diy_web/live/home_live.ex:1123
#, elixir-autogen, elixir-format
msgid "The page shows the build of the file now."
msgstr "Trang hiện đang hiển thị mô hình từ tệp."

#: lib/diy_web/live/home_live.ex:812
#, elixir-autogen, elixir-format
msgid "The planned items are part of your house now."
msgstr "Các thiết bị dự kiến giờ là một phần của ngôi nhà."

#: lib/diy_web/live/home_live.ex:477
#, elixir-autogen, elixir-format
msgid "The power station is at home now."
msgstr "Trạm sạc dự phòng giờ đã ở nhà."

#: lib/diy_web/live/home_live.ex:948
#, elixir-autogen, elixir-format
msgid "The worksheet has %{plan} now."
msgstr "Bảng tính giờ đã có %{plan}."

#: lib/diy_web/live/home_live.ex:952
#, elixir-autogen, elixir-format
msgid "The worksheet has 10 plans. Remove a plan first."
msgstr "Bảng tính có 10 gói điện. Hãy xóa một gói trước."

#: lib/diy_web/live/home_live.ex:751
#, elixir-autogen, elixir-format
msgid "These numbers give %{price} for each kWh. Check the total and the kWh of the bill."
msgstr "Các con số này cho ra %{price} mỗi kWh. Hãy kiểm tra tổng tiền và số kWh của hóa đơn."

#: lib/diy_web/live/home_live.ex:1525
#, elixir-autogen, elixir-format
msgid "This app needs JavaScript. Turn on JavaScript in the browser."
msgstr "Ứng dụng này cần JavaScript. Hãy bật JavaScript trong trình duyệt."

#: lib/diy_web/device.ex:199
#, elixir-autogen, elixir-format
msgid "This device did not save the build: %{error}"
msgstr "Thiết bị này chưa lưu được mô hình: %{error}"

#: lib/diy_web/live/home_live.ex:1041
#, elixir-autogen, elixir-format
msgid "This item cannot go in that room."
msgstr "Thiết bị này không thể đặt trong phòng đó."

#: lib/diy_web/live/home_live.ex:1047
#, elixir-autogen, elixir-format
msgid "This item or this room is not on the plan now."
msgstr "Thiết bị hoặc phòng này hiện không còn trên mặt bằng."
